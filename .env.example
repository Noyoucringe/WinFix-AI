# WinFix AI configuration example.
# Copy to `.env` and fill in as needed. WinFix works fully offline with the
# default `local` provider, so none of these are required to get started.
# NEVER commit your real .env or bake API keys into the packaged executable.

# --- LLM provider: "local" (default, offline), "openai", or "anthropic" ---
LLM_PROVIDER=local

# Required only for the matching cloud provider:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override (provider-specific default is used if empty):
MODEL_NAME=

# --- Backend ---
BACKEND_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000

# --- Safety limits ---
MAX_AGENT_STEPS=10
MAX_REMEDIATION_ATTEMPTS=3
DEFAULT_TOOL_TIMEOUT=15

# --- Logging ---
LOG_LEVEL=INFO
